{
  "name": "ascii-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-photos.mjs && vite",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "node scripts/prepare-photos.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node e2e/run.mjs && node e2e/editor.mjs && node e2e/multiplayer.mjs",
    "e2e:live": "node e2e/multiplayer.mjs",
    "e2e:edit": "node e2e/editor.mjs",
    "photos": "node scripts/prepare-photos.mjs"
  },
  "devDependencies": {
    "exifr": "^7.1.3",
    "puppeteer": "^23.11.1",
    "sharp": "^0.34.5",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "puppeteer@23.11.1": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
